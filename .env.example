# ============================================
# BACKEND - CONFIGURAÇÃO
# ============================================

# Banco de Dados
DB_HOST=localhost
DB_USER=chat
DB_PASSWORD=
DB_NAME=chat_interno
DB_PORT=3306

# Servidor
SERVER_PORT=8600
NODE_ENV=development
TRUST_PROXY=loopback
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT interno (minimo de 32 caracteres em producao)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Integração segura com o painel de atendimento.
# Use o mesmo valor em INTERNAL_CHAT_SERVICE_TOKEN na acessanet-chat-api.
ATENDIMENTO_INTEGRATION_TOKEN=
ATENDIMENTO_SSO_REDIRECT_ORIGINS=http://192.168.1.133:9520,http://localhost:9520,http://127.0.0.1:9520,http://localhost:5173,http://127.0.0.1:5173,https://atendimento.acessanet.com.br
ATENDIMENTO_SSO_CODE_TTL_MS=60000

# Mercado Livre API oficial
# Gere/renove este token no backend; ele nunca deve ir para o frontend.
MERCADO_LIVRE_ACCESS_TOKEN=

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:5173,http://192.168.1.133:5173

# SGP API para Diagnóstico de Conexão
# Use SGP_PROVIDER=ura para reaproveitar a consulta /api/ura/consultacliente/ por contrato.
# Use SGP_PROVIDER=generic para URLs HTTP próprias contendo os marcadores indicados.
SGP_API_ENABLED=false
SGP_PROVIDER=ura
SGP_URA_ENABLED=false
SGP_URA_BASE_URL=https://acessanet.sgp.net.br
SGP_URA_CONSULTA_CLIENTE_PATH=/api/ura/consultacliente/
SGP_URA_USERNAME=
SGP_URA_PASSWORD=
SGP_WEB_TRAFFIC_ENABLED=false
SGP_WEB_BASE_URL=https://acessanet.sgp.net.br
SGP_WEB_USERNAME=
SGP_WEB_PASSWORD=
SGP_WEB_TIMEOUT_SECONDS=30
SGP_CUSTOMER_SEARCH_URL=
SGP_CUSTOMER_DETAIL_URL=
SGP_AUTH_HEADER=Authorization
SGP_AUTH_PREFIX=Bearer 
SGP_AUTH_TOKEN=
SGP_TIMEOUT_SECONDS=10
SGP_CACHE_SECONDS=20

# Hillstone / StoneOS para Diagnóstico de Conexão
HILLSTONE_ENABLED=false
HILLSTONE_HOST=
HILLSTONE_PORT=
HILLSTONE_PROTOCOL=
HILLSTONE_USERNAME=
HILLSTONE_PASSWORD=
HILLSTONE_API_TOKEN=
HILLSTONE_SESSION_LOOKUP_URL=
HILLSTONE_TRAFFIC_LOOKUP_URL=
HILLSTONE_TIMEOUT_SECONDS=8
HILLSTONE_SNMP_VERSION=
HILLSTONE_SNMP_COMMUNITY=
HILLSTONE_SNMP_USER=
HILLSTONE_SNMP_AUTH_PROTOCOL=
HILLSTONE_SNMP_AUTH_PASSWORD=
HILLSTONE_SNMP_PRIV_PROTOCOL=
HILLSTONE_SNMP_PRIV_PASSWORD=

# Diagnóstico de Conexão - limites e permissões
NETWORK_DIAGNOSTIC_MAX_CONCURRENT=5
NETWORK_DIAGNOSTIC_USER_MAX_CONCURRENT=2
NETWORK_DIAGNOSTIC_TIMEOUT_SECONDS=60
NETWORK_DIAGNOSTIC_CLIENT_COOLDOWN_SECONDS=30
NETWORK_DIAGNOSTIC_RATE_LIMIT_PER_MINUTE=60
NETWORK_DIAGNOSTIC_PING_COUNT=5
NETWORK_DIAGNOSTIC_PING_TIMEOUT_SECONDS=2
NETWORK_DIAGNOSTIC_VIEW_PROFILES=
NETWORK_DIAGNOSTIC_RUN_PROFILES=
NETWORK_DIAGNOSTIC_HISTORY_PROFILES=
NETWORK_DIAGNOSTIC_ADMIN_PROFILES=
NETWORK_DIAGNOSTIC_VIEW_DEPARTMENT_IDS=
NETWORK_DIAGNOSTIC_RUN_DEPARTMENT_IDS=
NETWORK_DIAGNOSTIC_HISTORY_DEPARTMENT_IDS=
NETWORK_DIAGNOSTIC_ADMIN_DEPARTMENT_IDS=
NETWORK_DIAGNOSTIC_SUPPORT_SECTOR_KEYWORDS=suporte,atendimento tecnico,tecnico,n1,n2,n3
NETWORK_DIAGNOSTIC_NOC_SECTOR_KEYWORDS=noc,monitoramento,rede,redes
NETWORK_DIAGNOSTIC_HIGH_USAGE_PERCENT=85
NETWORK_DIAGNOSTIC_PACKET_LOSS_WARN_PERCENT=2
NETWORK_DIAGNOSTIC_PING_WARN_MS=80
NETWORK_DIAGNOSTIC_JITTER_WARN_MS=30
NETWORK_DIAGNOSTIC_OPTICAL_MIN_DBM=-27
NETWORK_DIAGNOSTIC_OPTICAL_MAX_DBM=-8

# Teste remoto de capacidade via ONU/CPE/ACS
REMOTE_SPEED_TEST_ENABLED=false
REMOTE_SPEED_TEST_PROVIDER=

# ============================================
# FRONTEND - CONFIGURAÇÃO
# ============================================

# API Base URL
VITE_API_URL=http://192.168.1.133:8600/api
VITE_SOCKET_URL=http://192.168.1.133:8600

# Ambiente
VITE_ENV=development
